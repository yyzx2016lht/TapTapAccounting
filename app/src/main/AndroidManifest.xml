<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 对照实验：health 类型（传感器监测语义，需 Android 14+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 读取相册图片（Android 13+） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- 读取相册图片（Android 12 及以下） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".TapApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TapAccounting"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickStartActivity"
            android:enabled="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".PermissionRequestActivity"
            android:enabled="true"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".OverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health|microphone|specialUse"
            android:stopWithTask="false">
            <!-- stopWithTask 默认即 false，这里显式写出：划掉最近任务卡片不应停掉手势服务。
                 实测 ColorOS 会在任务被移除后清理进程，此声明是对 ROM 的明确表态。 -->
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="flip_sensor_detection" />
        </service>

        <service
            android:name=".QuickStartTileService"
            android:exported="true"
            android:icon="@drawable/ic_edit"
            android:label="快速启动悬浮窗"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

        </service>

        <service
            android:name=".KeepAliveAccessibilityService"
            android:label="敲敲记账助手"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity android:name=".AppListActivity" android:label="应用白名单" />
    <activity android:name=".AddAssetActivity" android:label="新增资产" />
        <activity android:name=".BalanceAdjustmentActivity" android:label="@string/title_balance_adjustment" />
    <activity android:name=".SettingsActivity" android:label="分类管理" />
    <activity android:name=".CategorySortActivity" android:label="排序分类" />
        <activity
            android:name=".BackupHomeActivity"
            android:label="备份与恢复"
            android:exported="false" />
        <activity
            android:name=".StorageCleanupActivity"
            android:label="存储清理"
            android:exported="false" />
        <activity
            android:name=".ui.activity.HistoryBillActivity"
            android:label="回收站"
            android:exported="false" />
        <activity
            android:name=".StoragePreviewActivity"
            android:label="预览待清理内容"
            android:exported="false" />
        <activity
            android:name=".StorageImageViewerActivity"
            android:label="图片预览"
            android:exported="false" />
        <activity
            android:name=".BackupActivity"
            android:label="本地备份与恢复"
            android:exported="false" />
    <activity android:name=".AddCategoryActivity" android:label="新增分类" />
        <activity android:name=".LogViewerActivity" android:label="日志查看器" />
    <activity android:name=".ui.CurrencyManagerActivity" android:label="货币管理" />
    <activity android:name=".ui.ExchangeRateActivity" android:label="汇率管理" />
        <activity android:name=".BillDisplaySettingsActivity" android:label="账单显示效果" />
        <activity android:name=".ui.SensitivityActivity" android:label="灵敏度调节" android:screenOrientation="portrait" />
        <activity android:name=".GesturePermissionGuideActivity" android:label="快捷记账准备" />
        <activity android:name=".ui.activity.BillDetailActivity" android:label="账单详情" />
        <activity android:name=".ui.activity.RefundActivity" android:label="退款" />
    <activity android:name=".ui.activity.EditBillActivity" android:label="编辑账单" android:theme="@style/Theme.TapAccounting.Transparent" />
    <activity android:name=".ui.main.home.CalendarActivity" android:label="日历账单" android:theme="@style/Theme.TapAccounting.AppCompatNoActionBar"/>
    <activity android:name=".ui.main.home.BillSearchActivity" android:label="搜索账单" android:windowSoftInputMode="stateVisible|adjustResize" android:theme="@style/Theme.TapAccounting.AppCompatNoActionBar"/>
    <activity android:name=".ui.activity.BookOverviewActivity" android:label="账本总览" android:theme="@style/Theme.TapAccounting.AppCompatNoActionBar"/>
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TapAccounting.AppCompatNoActionBar" />

    <activity android:name=".ui.main.assets.AssetDetailActivity" android:label="资产详情" />
    <activity android:name=".ui.main.assets.AssetStatsActivity" android:label="资产统计" />
    <activity android:name=".AiRuleManageActivity" android:label="AI规则管理" />
    <activity android:name=".AiFeatureSettingsActivity" android:label="@string/title_ai_features" />
    <activity android:name=".AiConfigActivity" android:label="@string/title_ai_config" />
    <activity android:name=".ui.import.ImportOnboardingActivity" android:label="@string/import_onboarding_title" />
    <activity android:name=".ui.import.ImportReviewActivity" android:label="@string/import_review_title" />
    <activity android:name=".ui.budget.BudgetManageActivity" android:label="@string/budget_manage_title" />
    <activity android:name=".ui.recurring.RecurringBillsActivity" android:label="@string/recurring_bills_title" />
    <activity android:name=".ui.activity.AssetReconcileActivity" android:label="@string/reconcile_title" />
<!-- AiPromptEditorActivity removed: custom prompt editing is no longer supported -->
        <activity
            android:name=".ChatActivity"
            android:label="@string/title_chat"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TapAccounting" />
        <activity
            android:name=".ChatImagePreviewActivity"
            android:label="图片预览"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TapAccounting" />
        <activity
            android:name=".ChatSearchActivity"
            android:label="搜索聊天记录"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TapAccounting" />
        <activity
            android:name=".ScreenCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.TapAccounting.Transparent" />
        <activity
            android:name=".ImagePickerActivity"
            android:label="图片选择"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- 桌面小组件：四种固定样式共享同一套渲染逻辑，见 com.taostudio.tapaccounting.widget 包 -->
        <receiver
            android:name=".widget.CompactExpenseWidgetProvider"
            android:exported="true"
            android:label="支出金额 · 2×1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_compact" />
        </receiver>
        <receiver
            android:name=".widget.StandardExpenseWidgetProvider"
            android:exported="true"
            android:label="预算金额 · 2×1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_standard" />
        </receiver>
        <receiver
            android:name=".widget.TodayBudgetWidgetProvider"
            android:exported="true"
            android:label="今日花费与预算 · 2×1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_today_budget" />
        </receiver>
        <receiver
            android:name=".widget.DetailedExpenseWidgetProvider"
            android:exported="true"
            android:label="财务概览 · 4×2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_detailed" />
        </receiver>
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:label="桌面小组件设置"
            android:exported="true"
            android:theme="@style/Theme.TapAccounting">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:label="桌面小组件"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
