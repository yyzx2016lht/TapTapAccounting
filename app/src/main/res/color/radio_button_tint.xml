<?xml version="1.0" encoding="utf-8"?>
<!--
  选择控件（RadioButton / CheckBox）选中态。

  主题层已将 colorSecondary 统一为 brand_primary，绝大多数控件会自动继承。
  本文件仅用于显式声明，保证在未套用 App 主题的 Dialog 容器里
  （如部分 BottomSheetDialog）颜色也一致。

  背景：此前未设 tint 的控件会落到 colorSecondary = brand_secondary
  #FF4081（玫红），全项目有 54 处，备份页一屏内即出现 4 处玫红，
  与蓝色主按钮、蓝色开关割裂。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/brand_primary" />
    <item android:color="#B9C3D0" />
</selector>
