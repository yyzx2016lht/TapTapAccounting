<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asset_page_bg">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface_card"
        android:paddingHorizontal="@dimen/card_padding"
        android:elevation="4dp">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/icon_size_32"
            android:layout_height="@dimen/icon_size_32"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_left"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_primary"
            android:layout_centerVertical="true"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/add_asset_title"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/space_12"
            android:background="?attr/selectableItemBackground"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Basic Info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- Type Selection -->
                    <LinearLayout
                        android:id="@+id/layout_select_type"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/account_type"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_16"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical|end">
                            <ImageView
                                android:id="@+id/iv_type_icon"
                                android:layout_width="@dimen/icon_size_24"
                                android:layout_height="@dimen/icon_size_24"
                                android:layout_marginEnd="8dp"
                                android:src="@android:drawable/ic_menu_gallery"/>
                            <TextView
                                android:id="@+id/tv_type_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/please_select"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_16"
                                android:layout_marginEnd="4dp"/>
                            <ImageView
                                android:layout_width="@dimen/icon_size_16"
                                android:layout_height="@dimen/icon_size_16"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/asset_empty_icon_tint"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/account_name"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_16"/>
                        <EditText
                            android:id="@+id/et_name"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="20dp"
                            android:background="@null"
                            android:hint="@string/hint_input_name"
                            android:textColor="@color/brand_primary"
                            android:textColorHint="@color/text_secondary"
                            android:gravity="end|center_vertical"
                            android:textSize="@dimen/text_size_16"
                            android:singleLine="true"/>
                    </LinearLayout>

                    <!-- Balance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/account_balance"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_16"/>
                        <EditText
                            android:id="@+id/et_balance"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="20dp"
                            android:background="@null"
                            android:hint="0.00"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="@color/brand_primary"
                            android:textColorHint="@color/text_secondary"
                            android:gravity="end|center_vertical"
                            android:textSize="@dimen/text_size_16"/>
                    </LinearLayout>

                    <!-- Annual Interest Rate -->
                    <LinearLayout
                        android:id="@+id/layout_annual_interest_rate"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/annual_interest_rate"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_16"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="20dp"
                            android:gravity="center_vertical|end"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal">
                                <EditText
                                    android:id="@+id/et_annual_interest_rate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:minWidth="96dp"
                                    android:background="@null"
                                    android:hint="@string/optional"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:textColor="@color/brand_primary"
                                    android:textColorHint="@color/text_secondary"
                                    android:gravity="end|center_vertical"
                                    android:textSize="@dimen/text_size_16"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="%"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_size_16"/>
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="end"
                                android:text="@string/interest_rate_hint"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_12"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Credit Card: 信用额度 -->
                    <LinearLayout
                        android:id="@+id/layout_credit_limit"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="信用额度"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_16"/>
                        <EditText
                            android:id="@+id/et_credit_limit"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="20dp"
                            android:background="@null"
                            android:hint="0"
                            android:inputType="numberDecimal"
                            android:textColor="@color/brand_primary"
                            android:textColorHint="@color/text_secondary"
                            android:gravity="end|center_vertical"
                            android:textSize="@dimen/text_size_16"/>
                    </LinearLayout>

                    <!-- Credit Card: 账单日 / 还款日 -->
                    <LinearLayout
                        android:id="@+id/layout_credit_cycle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/layout_statement_day"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/credit_statement_day"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_16" />

                            <TextView
                                android:id="@+id/tv_statement_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textColor="@color/brand_primary"
                                android:textSize="@dimen/text_size_16" />

                            <ImageView
                                android:layout_width="@dimen/icon_size_16"
                                android:layout_height="@dimen/icon_size_16"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/asset_empty_icon_tint" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_due_day"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/credit_due_day"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_16" />

                            <TextView
                                android:id="@+id/tv_due_day"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textColor="@color/brand_primary"
                                android:textSize="@dimen/text_size_16" />

                            <ImageView
                                android:layout_width="@dimen/icon_size_16"
                                android:layout_height="@dimen/icon_size_16"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/asset_empty_icon_tint" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Asset Category -->
                    <LinearLayout
                        android:id="@+id/layout_select_asset_category"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?android:attr/selectableItemBackground">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="@string/asset_category"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_16"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical|end">
                            <TextView
                                android:id="@+id/tv_asset_category"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fund"
                                android:textColor="@color/brand_primary"
                                android:textSize="@dimen/text_size_16"
                                android:layout_marginEnd="4dp"/>
                            <ImageView
                                android:layout_width="@dimen/icon_size_16"
                                android:layout_height="@dimen/icon_size_16"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/asset_empty_icon_tint"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Advanced Settings -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- Currency -->
                    <LinearLayout
                        android:id="@+id/layout_select_currency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="?android:attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/currency"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_16"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical|end">
                                <TextView
                                    android:id="@+id/tv_currency"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="¥ CNY"
                                    android:textColor="@color/brand_primary"
                                    android:textSize="@dimen/text_size_16"
                                    android:layout_marginEnd="4dp"/>
                                <ImageView
                                    android:id="@+id/iv_arrow_cur"
                                    android:layout_width="@dimen/icon_size_16"
                                    android:layout_height="@dimen/icon_size_16"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/asset_empty_icon_tint"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/currency_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_12"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- Include in Net Asset -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="@string/include_total_asset"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_size_16"/>
                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/sw_include_net"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="true"/>
                        </RelativeLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="@string/include_total_asset_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_12"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Remark -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/radius_12"
                app:cardElevation="0dp">
                <EditText
                    android:id="@+id/et_remark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:background="@null"
                    android:hint="@string/remark"
                    android:textColor="@color/brand_primary"
                    android:textColorHint="@color/text_secondary"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textSize="@dimen/text_size_16"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:maxLines="1"
                    android:gravity="top"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Type Picker Overlay (Pinned to top, but below Toolbar) -->
    <LinearLayout
        android:id="@+id/layout_type_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@color/asset_page_bg"
        android:padding="16dp"
        android:visibility="gone">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <EditText
                android:id="@+id/et_search_type"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:hint="@string/hint_search_account_type"
                android:textColor="@color/brand_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingHorizontal="16dp"
                android:background="@android:drawable/edit_text"
                android:textSize="@dimen/text_size_14"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_icon_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:padding="8dp"/>
    </LinearLayout>

</RelativeLayout>
