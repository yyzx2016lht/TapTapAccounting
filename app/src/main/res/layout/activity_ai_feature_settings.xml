<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_card"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btn_back_ai_feature"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/ai_feature_title"
            android:textColor="@color/settings_item_title"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- AI 服务 -->
            <TextView
                style="@style/AiSectionLabel"
                android:text="@string/ai_page_section_service" />

            <androidx.cardview.widget.CardView
                android:id="@+id/layout_ai_status_card"
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-64dp"
                        android:layout_marginEnd="-48dp"
                        android:background="@drawable/bg_ai_status_decor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_ai_status_provider"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/ai_page_unconfigured_title"
                                android:textColor="@color/settings_item_title"
                                android:textSize="@dimen/text_size_18"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_ai_status_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_ai_pill_warn"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="@string/ai_page_badge_unconfigured"
                                android:textColor="#C77700"
                                android:textSize="@dimen/text_size_11"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:id="@+id/layout_ai_status_action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ai_page_action_switch"
                                    android:textColor="@color/settings_item_subtitle"
                                    android:textSize="@dimen/text_size_13" />

                                <ImageView style="@style/SettingsChevron" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_ai_status_key"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/ai_page_unconfigured_desc"
                            android:textColor="@color/settings_item_subtitle"
                            android:textSize="@dimen/text_size_12" />

                        <!-- 已配置：能力标签，在代码中按服务商能力生成 -->
                        <LinearLayout
                            android:id="@+id/layout_ai_status_caps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:visibility="gone" />

                        <!-- 未配置：三步引导 + 主按钮 -->
                        <LinearLayout
                            android:id="@+id/layout_ai_setup_guide"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/AiStepDot"
                                    android:background="@drawable/bg_ai_step_active"
                                    android:text="1"
                                    android:textColor="#FFFFFF" />

                                <TextView
                                    style="@style/AiStepLabel"
                                    android:text="@string/ai_page_step_provider"
                                    android:textColor="@color/settings_item_title" />

                                <View style="@style/AiStepLine" />

                                <TextView
                                    style="@style/AiStepDot"
                                    android:text="2" />

                                <TextView
                                    style="@style/AiStepLabel"
                                    android:text="@string/ai_page_step_key" />

                                <View style="@style/AiStepLine" />

                                <TextView
                                    style="@style/AiStepDot"
                                    android:text="3" />

                                <TextView
                                    style="@style/AiStepLabel"
                                    android:text="@string/ai_page_step_done" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btn_ai_setup"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="16dp"
                                android:background="@drawable/bg_ai_cta"
                                android:gravity="center"
                                android:text="@string/ai_page_setup_cta"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_14"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 记账方式 -->
            <TextView
                style="@style/AiSectionLabel"
                android:text="@string/ai_page_section_capture" />

            <androidx.cardview.widget.CardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 语音记账 -->
                    <LinearLayout
                        android:id="@+id/layout_tile_voice"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_page_voice_title" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_page_voice_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_show_voice"
                            style="@style/AiSwitch" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_detail_voice"
                        style="@style/AiSubGroup">

                        <LinearLayout
                            android:id="@+id/layout_asr_engine"
                            style="@style/AiSubRow"
                            android:background="@null"
                            android:clickable="false">

                            <TextView
                                style="@style/AiSubRowTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/ai_page_asr_mode" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_stats_segmented_control"
                                android:orientation="horizontal"
                                android:padding="3dp">

                                <TextView
                                    android:id="@+id/btn_asr_online"
                                    android:layout_width="56dp"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_stats_segmented_unselected"
                                    android:gravity="center"
                                    android:text="@string/ai_page_asr_cloud"
                                    android:textSize="@dimen/text_size_13" />

                                <TextView
                                    android:id="@+id/btn_asr_offline"
                                    android:layout_width="56dp"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_stats_segmented_unselected"
                                    android:gravity="center"
                                    android:text="@string/ai_page_asr_local"
                                    android:textSize="@dimen/text_size_13" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_asr_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <View style="@style/AiSubDivider" />

                            <LinearLayout
                                style="@style/AiSubRow"
                                android:paddingEnd="10dp"
                                android:background="@null"
                                android:clickable="false">

                                <LinearLayout style="@style/AiRowText">

                                    <TextView
                                        style="@style/AiSubRowTitle"
                                        android:text="@string/ai_page_asr_model" />

                                    <TextView
                                        android:id="@+id/tv_asr_model_status"
                                        style="@style/AiSubRowDesc"
                                        android:text="@string/model_status" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_asr_model_action"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:text="@string/download_model"
                                    android:textColor="@color/brand_primary"
                                    android:textSize="@dimen/text_size_13" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <!-- 图片记账 -->
                    <LinearLayout
                        android:id="@+id/layout_tile_image"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_page_image_title" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_page_image_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_show_ai_image"
                            style="@style/AiSwitch" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_image_accounting_sub_settings"
                        style="@style/AiSubGroup">

                        <LinearLayout
                            android:id="@+id/layout_receipt_image_draft_confirm"
                            style="@style/AiSubRow">

                            <LinearLayout style="@style/AiRowText">

                                <TextView
                                    style="@style/AiSubRowTitle"
                                    android:text="@string/ai_page_image_note_title" />

                                <TextView
                                    style="@style/AiSubRowDesc"
                                    android:text="@string/ai_page_image_note_desc" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_receipt_image_draft_confirm"
                                style="@style/AiSwitch" />
                        </LinearLayout>

                        <View style="@style/AiSubDivider" />

                        <LinearLayout
                            android:id="@+id/layout_image_accounting_natural_language"
                            style="@style/AiSubRow">

                            <LinearLayout style="@style/AiRowText">

                                <TextView
                                    style="@style/AiSubRowTitle"
                                    android:text="@string/ai_page_image_review_title" />

                                <TextView
                                    style="@style/AiSubRowDesc"
                                    android:text="@string/ai_page_image_review_desc" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_image_accounting_natural_language"
                                style="@style/AiSwitch" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <!-- 截屏记账 -->
                    <LinearLayout
                        android:id="@+id/layout_screen_accounting"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_page_screen_title" />

                            <TextView
                                android:id="@+id/tv_screen_accounting_desc"
                                style="@style/AiRowDesc"
                                android:text="@string/ai_page_screen_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_screen_accounting"
                            style="@style/AiSwitch" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_screen_accounting_image_flow"
                        style="@style/AiSubGroup">

                        <LinearLayout style="@style/AiSubRow">

                            <LinearLayout style="@style/AiRowText">

                                <TextView
                                    style="@style/AiSubRowTitle"
                                    android:text="@string/ai_page_screen_flow_title" />

                                <TextView
                                    style="@style/AiSubRowDesc"
                                    android:text="@string/ai_page_screen_flow_desc" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_screen_accounting_image_flow"
                                style="@style/AiSwitch" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 更多功能 -->
            <TextView
                style="@style/AiSectionLabel"
                android:text="@string/ai_page_section_more" />

            <androidx.cardview.widget.CardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_ai_main_entry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/layout_open_ai_chat_page"
                            style="@style/AiRow">

                            <LinearLayout style="@style/AiRowText">

                                <TextView
                                    style="@style/AiRowTitle"
                                    android:text="@string/ai_page_chat_title" />

                                <TextView
                                    style="@style/AiRowDesc"
                                    android:text="@string/ai_page_chat_desc" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_ai_chat_mode"
                                style="@style/AiSwitch" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <LinearLayout
                        android:id="@+id/layout_insight_cards"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_page_insight_title" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_page_insight_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_insight_cards"
                            style="@style/AiSwitch" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 分类规则 -->
            <TextView
                style="@style/AiSectionLabel"
                android:text="@string/ai_page_section_rules" />

            <androidx.cardview.widget.CardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_tile_rules"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_page_rules_title" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_page_rules_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_local_rule_override"
                            style="@style/AiSwitch" />
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <LinearLayout
                        android:id="@+id/btn_manage_ai_rules"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_page_rules_manage_title" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_page_rules_manage_desc" />
                        </LinearLayout>

                        <ImageView style="@style/SettingsChevron" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
