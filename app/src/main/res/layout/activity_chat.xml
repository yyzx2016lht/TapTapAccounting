<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_chat_sessions"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chat_page_bg">

        <ImageView
            android:id="@+id/iv_chat_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/toolbar_chat"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@color/chat_toolbar_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/btn_chat_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#333333" />

            <ImageView
                android:id="@+id/iv_ai_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_ai_default_avatar"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/layout_ai_name_click"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_ai_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小计"
                    android:textColor="@color/chat_bill_category_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ai_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/chat_bill_detail_text"
                android:textSize="12sp"
                android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_chat_mode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chat_mode_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/chat_mode_accounting"
                android:textColor="#3B5CCC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_chat_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#333333" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="always"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical"
            app:layout_constraintTop_toBottomOf="@id/toolbar_chat"
            app:layout_constraintBottom_toTopOf="@id/layout_chat_bottom"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/btn_chat_scroll_to_latest"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chat_scroll_to_latest"
            android:contentDescription="@string/scroll_to_latest"
            android:elevation="3dp"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_down_line"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layout_chat_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="#3B5CCC" />

        <LinearLayout
            android:id="@+id/layout_voice_record_overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chat_voice_record_overlay"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layout_chat_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/view_voice_record_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_voice_record_dot" />

            <ImageView
                android:id="@+id/iv_voice_record_state"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_chat_mic"
                android:visibility="gone"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_voice_record_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/recording_voice"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_voice_record_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/release_send_slide_cancel"
                    android:textColor="#A3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_voice_record_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_chat_bottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/chat_input_bar_bg"
            android:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/chat_divider" />

            <LinearLayout
                android:id="@+id/layout_voice_selection_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_voice_select_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_voice_selection_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voice_selected_count"
                    android:textColor="@color/chat_bill_category_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_voice_selection_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/cancel"
                    android:textColor="@color/chat_bill_detail_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_voice_selection_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dialog_action_item_danger"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/delete"
                    android:textColor="@color/chat_bill_action_danger_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp">

                <TextView
                    android:id="@+id/tv_voice_model_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_voice_hint"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/voice_model_warning"
                    android:textColor="@color/chat_bill_detail_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_pending_images"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_chat_attachment_panel"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_pending_image_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/selected_image_count_simple"
                            android:textColor="@color/chat_bill_category_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_clear_pending_images"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="@string/clear"
                            android:textColor="@color/chat_bill_detail_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/container_pending_images"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_chat_input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_chat_input_shell"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/btn_chat_attach"
                        android:layout_width="@dimen/chat_icon_btn_size"
                        android:layout_height="@dimen/chat_icon_btn_size"
                        android:background="@drawable/bg_input_icon_btn"
                        android:clickable="true"
                        android:contentDescription="@string/chat_attach_cd"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_chat_add"
                        app:tint="@color/chat_icon_btn_tint" />

                    <EditText
                        android:id="@+id/et_chat_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:hint="@string/chat_hint"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:minLines="1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="8dp"
                        android:textColor="@color/chat_ai_bubble_text"
                        android:textColorHint="@color/chat_input_hint"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_voice_hold"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                android:background="@drawable/bg_chat_voice_hold_btn"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.01"
                android:minHeight="42dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:stateListAnimator="@null"
                        android:text="@string/hold_to_talk"
                        android:textAllCaps="false"
                        android:textColor="@color/chat_ai_bubble_text"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_chat_mic"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/chat_icon_btn_tint"
                        app:rippleColor="@color/chat_icon_btn_pressed_bg"
                        app:strokeWidth="0dp" />

                    <ImageView
                        android:id="@+id/btn_voice_toggle"
                        android:layout_width="@dimen/chat_icon_btn_size"
                        android:layout_height="@dimen/chat_icon_btn_size"
                        android:background="@drawable/bg_input_icon_btn"
                        android:clickable="true"
                        android:contentDescription="@string/hold_to_talk"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_chat_mic"
                        app:tint="@color/chat_icon_btn_tint" />

                    <ImageView
                        android:id="@+id/btn_chat_stop"
                        android:layout_width="@dimen/chat_send_btn_size"
                        android:layout_height="@dimen/chat_send_btn_size"
                        android:background="@drawable/bg_chat_send_circle"
                        android:clickable="true"
                        android:contentDescription="@string/stop"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_stop_square"
                        android:visibility="gone"
                        app:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/btn_chat_send"
                        android:layout_width="@dimen/chat_send_btn_size"
                        android:layout_height="@dimen/chat_send_btn_size"
                        android:background="@drawable/bg_chat_send_circle"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_chat_send"
                        app:tint="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layout_session_drawer_container"
        android:layout_width="328dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_sidebar_root"
        android:elevation="12dp">

        <include layout="@layout/dialog_chat_sessions_panel" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
