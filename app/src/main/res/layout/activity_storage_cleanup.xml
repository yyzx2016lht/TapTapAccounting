<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <com.taostudio.tapaccounting.ui.widget.SecondaryPageHeaderView
        android:id="@+id/secondary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="存储清理" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_result"
                        android:textColor="@color/settings_item_title"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_cleanup_total_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:text="可清理总计：0 个文件 · 0 B"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cleanup_refresh"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:letterSpacing="0"
                        android:text="@string/rescan"
                        android:textColor="@color/text_body"
                        android:textSize="14sp"
                        app:backgroundTint="@color/backup_panel_bg"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_cleanup_content"
                        android:textColor="@color/settings_item_title"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/cleanup_safe_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <LinearLayout style="@style/CleanupItemRow">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_cleanup_voice"
                            style="@style/CleanupItemCheck"
                            android:checked="true"
                            android:text="@string/chat_voice_files" />

                        <TextView
                            android:id="@+id/tv_cleanup_voice_stats"
                            style="@style/CleanupItemStats"
                            android:text="0 个 · 0 B" />
                    </LinearLayout>

                    <LinearLayout style="@style/CleanupItemRow">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_cleanup_images"
                            style="@style/CleanupItemCheck"
                            android:checked="true"
                            android:text="@string/chat_image_files" />

                        <TextView
                            android:id="@+id/tv_cleanup_images_stats"
                            style="@style/CleanupItemStats"
                            android:text="0 个 · 0 B" />
                    </LinearLayout>

                    <LinearLayout style="@style/CleanupItemRow">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_cleanup_chat_avatar"
                            style="@style/CleanupItemCheck"
                            android:checked="false"
                            android:text="@string/chat_avatar_files" />

                        <TextView
                            android:id="@+id/tv_cleanup_chat_avatar_stats"
                            style="@style/CleanupItemStats"
                            android:text="0 个 · 0 B" />
                    </LinearLayout>

                    <LinearLayout style="@style/CleanupItemRow">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_cleanup_book_cover_bg"
                            style="@style/CleanupItemCheck"
                            android:checked="false"
                            android:text="@string/book_cover_bg" />

                        <TextView
                            android:id="@+id/tv_cleanup_book_cover_bg_stats"
                            style="@style/CleanupItemStats"
                            android:text="0 个 · 0 B" />
                    </LinearLayout>

                    <LinearLayout style="@style/CleanupItemRow">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_cleanup_temp_cache"
                            style="@style/CleanupItemCheck"
                            android:checked="true"
                            android:text="@string/temp_cache_files" />

                        <TextView
                            android:id="@+id/tv_cleanup_temp_cache_stats"
                            style="@style/CleanupItemStats"
                            android:text="0 个 · 0 B" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="6dp"
                        android:background="@color/divider_soft" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cb_cleanup_older_30"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/cleanup_30day_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        app:buttonTint="@color/brand_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cleanup_preview"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:letterSpacing="0"
                        android:text="@string/preview_files"
                        android:textColor="@color/text_body"
                        android:textSize="14sp"
                        app:backgroundTint="@color/backup_panel_bg"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cleanup_do"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:text="@string/cleanup_selected"
                        android:textColor="@color/settings_danger_text"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/settings_danger_text"
                        app:strokeColor="@color/backup_danger_stroke"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_history_bills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/settings_card_bg"
                app:cardCornerRadius="@dimen/settings_card_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trash"
                            android:textColor="@color/settings_item_title"
                            android:textSize="@dimen/text_size_16"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_history_bills_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/view_deleted_bills"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#999999" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
