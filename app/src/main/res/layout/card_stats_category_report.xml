<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/stats_card_margin_h"
    android:layout_marginTop="@dimen/stats_card_margin_top"
    app:cardBackgroundColor="@color/stats_card_bg"
    app:cardCornerRadius="@dimen/stats_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/stats_card_stroke"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/stats_card_padding">

        <TextView
            android:id="@+id/tv_category_report_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/proportion_analysis"
            android:textColor="@color/stats_segmented_text_active"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold" />

        <!-- Expense / Income segmented control -->
        <LinearLayout
            android:id="@+id/layout_category_type_switcher"
            android:layout_width="match_parent"
            android:layout_height="@dimen/stats_segmented_height"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_stats_segmented_control"
            android:orientation="horizontal"
            android:padding="3dp">

            <FrameLayout
                android:id="@+id/btn_category_expense"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_stats_segmented_selected"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/expense"
                    android:textColor="@color/stats_segmented_text_active"
                    android:textSize="@dimen/text_size_13"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_category_income"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_stats_segmented_unselected">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/income"
                    android:textColor="@color/stats_segmented_text_inactive"
                    android:textSize="@dimen/text_size_13"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_chart"
                android:layout_width="match_parent"
                android:layout_height="230dp" />

            <LinearLayout
                android:id="@+id/layout_tab_empty_state"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_stats_empty"
                    android:alpha="1" />

                <TextView
                    android:id="@+id/tv_tab_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/no_expense_data"
                    android:textColor="@color/stats_empty_text"
                    android:textSize="@dimen/text_size_13" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layout_category_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_category_chart_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_size_12" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/space_12"
            android:background="@color/stats_card_stroke" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
