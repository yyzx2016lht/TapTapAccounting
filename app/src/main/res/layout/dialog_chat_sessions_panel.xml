<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_page_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/session_center"
        android:textColor="@color/chat_ai_bubble_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/session_center_hint"
        android:textColor="@color/chat_bill_detail_text"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_session_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_chat_sidebar_search"
        android:hint="@string/hint_search_session"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="@color/chat_ai_bubble_text"
        android:textColorHint="@color/chat_input_hint"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_new_session"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_sidebar_action_primary"
            android:gravity="center"
            android:text="@string/new_session"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_reply_style"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_sidebar_action_soft"
            android:gravity="center"
            android:text="@string/reply_style"
            android:textColor="@color/chat_ai_bubble_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_change_chat_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chat_sidebar_action_soft"
        android:gravity="center"
        android:text="@string/change_chat_bg"
        android:textColor="@color/chat_ai_bubble_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="2dp"
        android:text="@string/history_session"
        android:textColor="@color/chat_bill_detail_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_session_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/btn_clear_current_session"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chat_sidebar_action_danger"
        android:gravity="center"
        android:text="@string/clear_current_session"
        android:textColor="@color/danger_color"
        android:textSize="14sp" />
</LinearLayout>
