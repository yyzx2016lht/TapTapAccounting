<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_accounting_panel"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/fl_followup_confirm_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_dialog_icon_badge_brand"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_followup_confirm_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_followup_confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/dialog_title"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_followup_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/dialog_subtitle"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/btn_followup_confirm_ok"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_dialog_button_primary"
        android:gravity="center"
        android:textColor="@color/dialog_button_primary_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_followup_confirm_cancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dialog_button_cancel"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/dialog_button_cancel_text"
        android:textSize="15sp" />

</LinearLayout>
