<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/page_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_rule_subtle_chip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_recurring_due_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recurring_due_prompt_title"
            android:textColor="#111827"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_recurring_due_close"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="X"
            android:textColor="#6B7280"
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_recurring_due_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#4B5563"
        android:textSize="@dimen/text_size_14" />

    <TextView
        android:id="@+id/tv_recurring_due_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_stats_metric_tile"
        android:padding="12dp"
        android:textColor="#6B7280"
        android:textSize="@dimen/text_size_12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/recurring_due_amount_label"
        android:textColor="#374151"
        android:textSize="@dimen/text_size_14" />

    <EditText
        android:id="@+id/et_recurring_due_amount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_stats_filter_field_rect"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="#111827"
        android:textSize="@dimen/text_size_16" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_recurring_due_record"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:text="@string/recurring_due_record"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_size_14"
        app:backgroundTint="@color/brand_primary"
        app:cornerRadius="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_recurring_due_skip_today"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/recurring_due_skip_today"
            android:textColor="#6B7280"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/btn_recurring_due_cancel_pattern"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/recurring_due_cancel_pattern"
            android:textColor="@color/danger_color"
            android:textSize="@dimen/text_size_13" />
    </LinearLayout>
</LinearLayout>
