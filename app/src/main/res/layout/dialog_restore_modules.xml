<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restore_screen_title"
            android:textColor="#1A2744"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/restore_screen_subtitle"
            android:textColor="#7C8798"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_backup_group"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restore_mode"
                android:textColor="#2D3C57"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_restore_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_restore_merge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/restore_merge_title"
                    android:textColor="#2D3C57"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/restore_merge_desc"
                    android:textColor="#6E7D95"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rb_restore_overwrite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_overwrite_title"
                    android:textColor="#2D3C57"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="@string/restore_overwrite_desc"
                    android:textColor="#6E7D95"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_restore_shared"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_backup_warning"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restore_shared_section"
                android:textColor="#8A3B2A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_restore_shared_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#6E534C"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_restore_shared"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/rb_shared_reconnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#2D3C57"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_shared_local"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shared_restore_local_copy"
                    android:textColor="#2D3C57"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_restore_adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/restore_adjust_content_hide"
            android:textColor="@color/brand_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/group_restore_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_select_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/restore_select_all"
                android:textColor="#1A2744"
                android:textSize="15sp"
                android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/group_restore_core"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_backup_group"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/core_bookkeeping"
                android:textColor="#2D3C57"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asset_data"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category_settings"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_bills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bill_records"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accounting_habits"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_budgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/budget_data"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_recurring_patterns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recurring_patterns"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_banners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_cover"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_restore_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_backup_group"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_and_dialog"
                android:textColor="#2D3C57"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_chat_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_records"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_chat_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_resources"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_restore_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_backup_group"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferences_and_ui"
                android:textColor="#2D3C57"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_basic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/basic_settings"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asset_and_rate"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_cloud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cloud_config"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_and_card"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_bills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bill_display"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_multibill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/multi_book_ocr"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_ai_core"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_core_model"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_restore_settings_ai_core_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:text="@string/ai_core_model_description"
                android:textColor="#8C98A8"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_ai_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_chat_settings"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_preference"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_advanced_runtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system_and_debug"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />


            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_general_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_general_legacy"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_display_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_display_legacy"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_restore_settings_advanced_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_advanced_legacy"
                android:textColor="#23324A"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
