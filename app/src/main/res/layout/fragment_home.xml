<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerBooks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_page">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/homeAppBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    app:elevation="0dp"
                    app:liftOnScroll="true">

                <FrameLayout
                    android:id="@+id/headerBannerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="246dp"
                    android:minHeight="88dp"
                    android:background="@drawable/bg_home_header_gradient"
                    app:layout_scrollFlags="scroll|exitUntilCollapsed">

                    <ImageView
                        android:id="@+id/ivHeaderBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                        <!-- 顶部暗化遮罩，专门保护顶栏胶囊和图标可读性 -->
                        <View
                            android:id="@+id/vBannerTopScrim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_banner_top_scrim"
                            android:visibility="gone" />

                        <!-- 图片封面时的底部渐变遮罩，纯色背景时隐藏 -->
                        <View
                            android:id="@+id/vBannerGradient"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_banner_gradient"
                            android:visibility="gone" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layoutHeaderSummary"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="24dp"
                            android:paddingTop="82dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="18dp">

                            <LinearLayout
                                android:id="@+id/layoutHeadlineBlock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/tvMonthExpenseLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_month_expense"
                                    android:textColor="#CCFFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="normal"
                                    android:fontFamily="sans-serif"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/tvMonthExpense"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="&#xA5;0.00"
                                    android:textColor="#FFFFFF"
                                    android:textSize="30sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-medium"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="0"
                                    android:lineSpacingExtra="0dp" />
                            </LinearLayout>

                            <!--
                                预算进度条：仅在「启用预算」且该月确实有预算时显示。
                                底色（track）与填充（indicator）不写死颜色，由 HomeBannerController
                                按 banner 底色明暗切成浅色/深色，否则浅色账本色下会看不见。
                                也不写死橙红预警色——banner 底色是用户可变的 16 色色板，
                                预警信号靠长度和 ⚠ 文案表达。
                            -->
                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progressBudgetBar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="12dp"
                                android:visibility="gone"
                                app:layout_constraintBottom_toTopOf="@id/layoutSummaryFooter"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/layoutHeadlineBlock"
                                app:trackCornerRadius="3dp"
                                app:trackThickness="4dp"
                                tools:visibility="visible" />

                            <LinearLayout
                                android:id="@+id/layoutSummaryFooter"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvMonthIncomeLabel"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/home_month_income"
                                        android:textColor="#CCFFFFFF"
                                        android:textSize="14sp"
                                        android:textStyle="normal"
                                        android:fontFamily="sans-serif"
                                        android:includeFontPadding="false" />

                                    <TextView
                                        android:id="@+id/tvMonthIncome"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="&#xA5;0.00"
                                        android:textColor="#FFFFFF"
                                        android:textSize="17sp"
                                        android:textStyle="normal"
                                        android:letterSpacing="0"
                                        app:autoSizeMaxTextSize="17sp"
                                        app:autoSizeMinTextSize="12sp"
                                        app:autoSizeStepGranularity="1sp"
                                        app:autoSizeTextType="uniform" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvMonthBalanceLabel"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/home_month_balance"
                                        android:textColor="#CCFFFFFF"
                                        android:textSize="14sp"
                                        android:textStyle="normal"
                                        android:fontFamily="sans-serif"
                                        android:includeFontPadding="false" />

                                    <TextView
                                        android:id="@+id/tvMonthBalance"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="&#xA5;0.00"
                                        android:textColor="#FFFFFF"
                                        android:textSize="17sp"
                                        android:textStyle="normal"
                                        android:letterSpacing="0"
                                        app:autoSizeMaxTextSize="17sp"
                                        app:autoSizeMinTextSize="12sp"
                                        app:autoSizeStepGranularity="1sp"
                                        app:autoSizeTextType="uniform" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutSyncError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_sync_error"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:visibility="gone"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_error"
                                    app:tint="#FF5252" />

                                <TextView
                                    android:id="@+id/tvSyncError"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:textColor="#FF5252"
                                    android:textSize="11sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <RelativeLayout
                            android:id="@+id/layoutHeaderTopBar"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp"
                            android:paddingHorizontal="16dp"
                            android:visibility="invisible">

                            <ImageView
                                android:layout_width="@dimen/icon_size_28"
                                android:layout_height="@dimen/icon_size_28"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_switch_book"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="2026-03"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_18"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="@dimen/icon_size_28"
                                android:layout_height="@dimen/icon_size_28"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_home_calendar"
                                app:tint="#FFFFFF" />
                        </RelativeLayout>

                        <!--
                            多选状态面板（COMFORT-REVIEW 第 14 条）：替换 layoutHeaderSummary 的位置，
                            与它同一套排版（标签 / 大数字 / 底部两栏），背景透明以保留账本自定义色与封面图。
                            文字颜色与阴影由 HomeUiListController 从原统计控件同步，跟随 banner 对比度逻辑。
                            结构固定：转账/还款只追加第三栏计数，不替换金额。
                        -->
                        <LinearLayout
                            android:id="@+id/layoutMultiSelectSummary"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="24dp"
                            android:paddingTop="82dp"
                            android:paddingEnd="24dp"
                            android:paddingBottom="18dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tvMultiSelectSummaryLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="sans-serif"
                                android:includeFontPadding="false"
                                android:text="@string/multi_select_summary_label"
                                android:textColor="#CCFFFFFF"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvMultiSelectSummaryTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="#FFFFFF"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                tools:text="3 笔" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvMsSummaryExpenseLabel"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:includeFontPadding="false"
                                        android:text="@string/multi_select_summary_expense"
                                        android:textColor="#CCFFFFFF"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/tvMsSummaryExpense"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textColor="#FFFFFF"
                                        android:textSize="17sp"
                                        app:autoSizeMaxTextSize="17sp"
                                        app:autoSizeMinTextSize="12sp"
                                        app:autoSizeStepGranularity="1sp"
                                        app:autoSizeTextType="uniform"
                                        tools:text="¥30.28" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvMsSummaryIncomeLabel"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:includeFontPadding="false"
                                        android:text="@string/multi_select_summary_income"
                                        android:textColor="#CCFFFFFF"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/tvMsSummaryIncome"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textColor="#FFFFFF"
                                        android:textSize="17sp"
                                        app:autoSizeMaxTextSize="17sp"
                                        app:autoSizeMinTextSize="12sp"
                                        app:autoSizeStepGranularity="1sp"
                                        app:autoSizeTextType="uniform"
                                        tools:text="¥0.00" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/layoutMsSummaryOther"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="24dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:visibility="gone"
                                    tools:visibility="visible">

                                    <TextView
                                        android:id="@+id/tvMsSummaryOtherLabel"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="@string/multi_select_summary_other"
                                        android:textColor="#CCFFFFFF"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/tvMsSummaryOther"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textColor="#FFFFFF"
                                        android:textSize="17sp"
                                        tools:text="2 笔" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                </FrameLayout>

                </com.google.android.material.appbar.AppBarLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="true"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="96dp"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    tools:listitem="@layout/item_home_transaction" />

                <!-- 固定顶栏：始终覆盖在 AppBarLayout 上方，不随折叠滚动消失 -->
                <!-- 月份选择器 / 账本切换 / 日历 三个控件在此处 -->
                <RelativeLayout
                    android:id="@+id/layoutStickyTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_gravity="top"
                    android:elevation="0dp"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivBookSwitcher"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="&#x5207;&#x6362;&#x8D26;&#x6237;"
                        android:focusable="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_switch_book"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvMonthSelector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:drawableEnd="@drawable/ic_chevron_down_home"
                        android:drawablePadding="4dp"
                        android:paddingStart="2dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="2dp"
                        android:paddingBottom="4dp"
                        android:text="2026-03"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivCalendarView"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_toStartOf="@id/ivSearchBill"
                        android:layout_marginEnd="8dp"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_home_calendar"
                        app:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/ivSearchBill"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/search_bills"
                        android:focusable="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_home_search"
                        app:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/ivSyncStatus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_below="@id/ivSearchBill"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="7dp"
                        android:src="@drawable/ic_sync_status"
                        android:visibility="gone"
                        app:tint="#FFFFFF" />
                </RelativeLayout>

            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/layout_multi_select_actions"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="#FFFFFF"
            android:elevation="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_ms_cancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:text="@string/close_symbol"
                android:textColor="#666666"
                android:textSize="@dimen/text_size_18" />

            <TextView
                android:id="@+id/btn_ms_select_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:text="@string/select_all"
                android:textColor="#333333"
                android:textSize="@dimen/text_size_16" />

            <TextView
                android:id="@+id/btn_ms_move_book"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:text="@string/move"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/text_size_16" />

            <TextView
                android:id="@+id/btn_ms_exclude_stats"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/shape_button_outline"
                android:gravity="center"
                android:text="@string/exclude"
                android:textColor="#333333"
                android:textSize="@dimen/text_size_16" />

            <TextView
                android:id="@+id/btn_ms_delete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/shape_button_outline_red"
                android:gravity="center"
                android:text="@string/delete"
                android:textColor="@color/danger_color"
                android:textSize="@dimen/text_size_16" />
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutBookDrawer"
        android:layout_width="312dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EFF3FB"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#DCE5F2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/book"
                        android:textColor="#15294B"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/manage_book_space"
                        android:textColor="#8E9CAF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnBookOverview"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_book_overview_entry_btn"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/overview"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#DCE5F2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/my_books"
                    android:textColor="#8E9CAF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBookAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    tools:listitem="@layout/item_book_account" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#DCE5F2"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/btnViewScope"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="8dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="合并查看多个账本"
                android:textColor="#6E7D94"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#DCE5F2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/quick_create"
                    android:textColor="#8E9CAF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAddBookAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_book_item_selected"
                    android:gravity="center"
                    android:text="@string/add_new_book"
                    android:textColor="@color/brand_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnJoinSharedLedger"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_book_item_normal"
                    android:gravity="center"
                    android:text="加入共享账本"
                    android:textColor="@color/brand_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutAddBookInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_book_item_normal"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etAddBookAccountName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_book_name"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textColor="#1A2744"
                        android:textColorHint="#9BA8BA"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnConfirmAddBook"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="confirm add account"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_save"
                        android:tint="#2FA36B" />

                    <ImageView
                        android:id="@+id/btnCancelAddBook"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="cancel add account"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="#9AA1AA" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnAddBookSetDefaultToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_add_book_default_toggle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/set_default_hint"
                    android:textColor="#6E7D94"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
