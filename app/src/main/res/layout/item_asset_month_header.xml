<?xml version="1.0" encoding="utf-8"?>
<!--
    月份分组头。勾选框做「覆盖层 + 占位 View」，不参与行高测量，
    避免进/出多选时分组头高度变化导致列表跳动；横向让位由 sp_header_check 的宽度动画完成。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_bill_group_top"
    android:paddingHorizontal="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="20dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/sp_header_check"
            android:layout_width="0dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tv_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="03月"
            android:textColor="#222222"
            android:textSize="@dimen/text_size_15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_month_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:lines="2"
            android:text="流入:¥0.00&#10;流出:¥0.00"
            android:textColor="#9AA1AA"
            android:textSize="@dimen/text_size_13" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cb_select_section"
        android:layout_width="32dp"
        android:layout_height="20dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginEnd="6dp"
        android:buttonTint="@color/brand_primary"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical|start"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:visibility="gone" />

</FrameLayout>
