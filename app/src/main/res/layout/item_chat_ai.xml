<?xml version="1.0" encoding="utf-8"?>
<!-- AI 消息（左侧） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/chat_msg_spacing_horizontal"
    android:paddingEnd="@dimen/chat_message_side_inset"
    android:paddingTop="@dimen/chat_msg_spacing_vertical"
    android:paddingBottom="@dimen/chat_msg_spacing_vertical">

    <TextView
        android:id="@+id/tv_ai_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/chat_time_margin_bottom"
        android:gravity="center"
        android:textColor="@color/chat_time_chip_text"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|top"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_ai_text_select"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_ai_avatar_msg"
            android:layout_width="@dimen/chat_avatar_size"
            android:layout_height="@dimen/chat_avatar_size"
            android:layout_marginEnd="@dimen/chat_avatar_margin_end"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_ai_default_avatar" />

        <LinearLayout
            android:id="@+id/layout_ai_text_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_ai_name_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textColor="@color/chat_time_chip_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_ai_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_bubble_ai"
                android:lineSpacingExtra="4dp"
                android:linksClickable="true"
                android:maxWidth="@dimen/chat_message_max_width"
                android:paddingHorizontal="@dimen/chat_bubble_padding_h"
                android:paddingVertical="@dimen/chat_bubble_padding_v"
                android:textColor="@color/chat_ai_bubble_text"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/layout_conversation_mode_nudge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chat_mode_nudge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_conversation_mode_nudge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_conversation_mode_nudge"
                    android:textColor="@color/chat_bill_detail_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_switch_conversation_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="@string/chat_switch_conversation_mode"
                    android:textColor="#3B5CCC"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_ai_loading_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_ai_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_bubble_ai"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/chat_bubble_padding_h"
                    android:paddingVertical="@dimen/chat_bubble_padding_v">

                    <com.taostudio.tapaccounting.ui.chat.ChatTypingDotsView
                        android:id="@+id/typing_dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_ai_loading_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:linksClickable="true"
                        android:maxWidth="@dimen/chat_message_max_width"
                        android:textColor="@color/chat_loading_text"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_ai_interrupt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
