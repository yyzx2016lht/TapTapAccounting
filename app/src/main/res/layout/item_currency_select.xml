<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_currency_flag"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_segmented_container"
            android:gravity="center"
            android:text="🇺🇸"
            android:textColor="#000000"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_currency_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USD"
                    android:textColor="#203047"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 主币种徽章：用徽章解释 CNY 为何不可取消，而不是把整行变暗 -->
                <TextView
                    android:id="@+id/tv_primary_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segmented_container"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/currency_primary_badge"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_currency_symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_segmented_container"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="$"
                    android:textColor="#4B5B74"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_currency_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="美元（美国）"
                android:textColor="#778399"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
