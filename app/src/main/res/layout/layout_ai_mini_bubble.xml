<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="54dp"
    android:layout_height="54dp"
    android:background="@drawable/bg_ai_mini_bubble"
    android:contentDescription="@string/ai_panel_bubble_desc">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_ai_robot" />

    <View
        android:id="@+id/view_ai_mini_bubble_badge"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_ai_mini_bubble_badge"
        android:visibility="gone" />
</FrameLayout>
