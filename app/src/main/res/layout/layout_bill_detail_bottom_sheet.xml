<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_stats_sheet_handle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail"
            android:textColor="@color/dialog_title"
            android:textSize="@dimen/dialog_title_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btn_exclude_stats"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_dialog_button_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/include"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_13" />

            <TextView
                android:id="@+id/btn_refund"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dialog_button_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/refund"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_13" />

            <TextView
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dialog_button_outline"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/edit"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_13" />

            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dialog_button_danger"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/delete"
                android:textColor="@color/danger_color"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/dialog_divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_detail_amount_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/amount"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_detail_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-¥0.00"
                        android:textColor="@color/danger_color"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_detail_amount_formula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="退款¥0.00，实际支出¥0.00"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_size_12"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/line_incoming"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/dialog_divider"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_detail_incoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_detail_incoming_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/transfer_amount"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_incoming_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="$0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/line_amount"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/dialog_divider" />

            <LinearLayout
                android:id="@+id/layout_detail_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/fee"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_fee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/warning_color"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:id="@+id/line_fee_detail"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/dialog_divider"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_detail_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/category_tag"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:id="@+id/line_category"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/dialog_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_detail_account_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/account_tag"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/dialog_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tv_detail_time_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/time_tag"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_detail_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_14" />

                    <TextView
                        android:id="@+id/tv_detail_record_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=""
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_size_12" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/dialog_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/remark_tag"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_remark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_14" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/dialog_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="@string/book"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_size_14" />

                <TextView
                    android:id="@+id/tv_detail_book_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_15" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_refund_records_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F2F4F7"
                    android:padding="12dp"
                    android:text="@string/refund_records"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_refund_records_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_original_bill_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_segmented_container"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/original_bill"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_13"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/refund_source_bill_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_12" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_original_bill_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
