<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_ai_config"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_card"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btn_back_to_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/title_ai_config"
            android:textColor="@color/settings_item_title"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/root_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- 服务商 -->
            <TextView
                style="@style/AiSectionLabel"
                android:text="@string/ai_cfg_section_provider" />

            <androidx.cardview.widget.CardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_provider_selector"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                android:id="@+id/tv_current_provider"
                                style="@style/AiRowTitle"
                                android:textSize="@dimen/text_size_16" />

                            <TextView
                                android:id="@+id/tv_provider_capabilities"
                                style="@style/AiRowDesc" />
                        </LinearLayout>

                        <TextView
                            style="@style/AiRowValue"
                            android:text="@string/ai_page_action_switch" />

                        <ImageView style="@style/SettingsChevron" />
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <!-- API 密钥 -->
                    <LinearLayout
                        android:id="@+id/btn_edit_api_key_row"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_key_title" />

                            <TextView
                                android:id="@+id/tv_api_key_state"
                                style="@style/AiRowDesc"
                                android:ellipsize="end"
                                android:maxLines="1" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_edit_api_key"
                            style="@style/AiRowValue"
                            android:text="@string/ai_key_action_replace"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_api_key_editor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/settings_item_padding_h"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_search_box"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_api_key"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/ai_key_replace_hint"
                                android:importantForAutofill="no"
                                android:inputType="textPassword"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textSize="@dimen/text_size_14" />

                            <TextView
                                android:id="@+id/btn_toggle_api_key"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="@string/ai_key_show"
                                android:textColor="@color/settings_item_subtitle"
                                android:textSize="@dimen/text_size_12" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_cancel_api_key"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/cancel_btn"
                                android:textColor="@color/settings_item_subtitle"
                                android:textSize="@dimen/text_size_13" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_save_api_key"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="@color/brand_primary"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/ai_key_save"
                                android:textAllCaps="false"
                                android:textSize="@dimen/text_size_13"
                                app:cornerRadius="18dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <!-- 测试连接 -->
                    <LinearLayout
                        android:id="@+id/btn_test_conn"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_test_title" />

                            <TextView
                                android:id="@+id/tv_test_conn_desc"
                                style="@style/AiRowDesc"
                                android:text="@string/ai_cfg_test_desc_empty" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_test_conn_action"
                            style="@style/AiRowValue"
                            android:text="@string/ai_cfg_test_action"
                            android:textColor="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 模型 -->
            <TextView
                style="@style/AiSectionLabel"
                android:text="@string/ai_cfg_section_models" />

            <androidx.cardview.widget.CardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_manual_title" />

                            <TextView
                                android:id="@+id/tv_default_model_readonly_hint"
                                style="@style/AiRowDesc"
                                android:text="@string/ai_cfg_manual_desc_off" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_manual_model_selection"
                            style="@style/AiSwitch" />
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <LinearLayout
                        android:id="@+id/layout_row_text_model"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_text_model" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_cfg_text_model_desc" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_text_model_value"
                            style="@style/AiModelValue" />

                        <ImageView
                            android:id="@+id/iv_text_model_chevron"
                            style="@style/SettingsChevron" />
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <LinearLayout
                        android:id="@+id/layout_row_vision_model"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_vision_model" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_cfg_vision_model_desc" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_vision_model_value"
                            style="@style/AiModelValue" />

                        <ImageView
                            android:id="@+id/iv_vision_model_chevron"
                            style="@style/SettingsChevron" />
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <LinearLayout
                        android:id="@+id/layout_row_speech_model"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_speech_model" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_cfg_speech_model_desc" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_speech_model_value"
                            style="@style/AiModelValue" />

                        <ImageView
                            android:id="@+id/iv_speech_model_chevron"
                            style="@style/SettingsChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_restore_default_models"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View style="@style/AiDivider" />

                        <TextView
                            android:id="@+id/btn_restore_default_models"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:text="@string/ai_cfg_restore_defaults"
                            android:textColor="@color/brand_primary"
                            android:textSize="@dimen/text_size_14" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 深度思考 -->
            <TextView
                style="@style/AiSectionLabel"
                android:text="@string/ai_cfg_section_thinking" />

            <androidx.cardview.widget.CardView
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_thinking_text"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_thinking_text_title" />

                            <TextView
                                style="@style/AiRowDesc"
                                android:text="@string/ai_cfg_thinking_text_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_thinking_text"
                            style="@style/AiSwitch" />
                    </LinearLayout>

                    <View style="@style/AiDivider" />

                    <LinearLayout
                        android:id="@+id/layout_thinking_vision"
                        style="@style/AiRow">

                        <LinearLayout style="@style/AiRowText">

                            <TextView
                                style="@style/AiRowTitle"
                                android:text="@string/ai_cfg_thinking_vision_title" />

                            <TextView
                                android:id="@+id/tv_thinking_vision_hint"
                                style="@style/AiRowDesc"
                                android:text="@string/ai_cfg_thinking_vision_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_thinking_vision"
                            style="@style/AiSwitch" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/ai_cfg_thinking_footnote"
                android:textColor="#9AA4B2"
                android:textSize="@dimen/text_size_11" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
