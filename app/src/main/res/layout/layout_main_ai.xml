<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_ai_config"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface_card"
            android:paddingHorizontal="12dp">
            <ImageView
                android:id="@+id/btn_back_to_settings"
                android:layout_width="@dimen/icon_size_40"
                android:layout_height="@dimen/icon_size_40"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_ai_config"
                android:textSize="@dimen/text_size_18"
                android:textStyle="bold"
                android:textColor="@color/settings_item_title"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:id="@+id/root_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_provider_current_label"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/settings_section_title_size"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:id="@+id/layout_provider_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ai_input_modern"
                android:padding="@dimen/card_padding"
                android:layout_marginBottom="@dimen/settings_card_margin_bottom"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_current_provider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_provider_capabilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#667085"
                    android:textSize="@dimen/text_size_12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ai_provider_change"
                    android:textColor="#5C6BC0"
                    android:textSize="@dimen/text_size_12"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_settings"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/settings_section_title_size"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ai_input_modern"
                android:padding="@dimen/card_padding"
                android:layout_marginBottom="@dimen/settings_card_margin_bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/api_key"
                    android:textColor="#666666"
                    android:textSize="@dimen/text_size_12"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/et_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/input_api_key_hint"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_search_box"
                    android:paddingHorizontal="12dp"
                    android:textSize="@dimen/text_size_14"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_conn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/test_connection"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    android:backgroundTint="#E3F2FD"
                    android:textColor="#1976D2"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BBDEFB"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/test_connection_hint"
                    android:textColor="#999999"
                    android:textSize="@dimen/text_size_11" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                    android:text="@string/ai_service_config_btn"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/settings_section_title_size"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_ai_input_modern"
                android:padding="@dimen/card_padding"
                android:layout_marginBottom="24dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_enable_receipt_ocr_refine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_image_recognition"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_13"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ocr_refine_desc"
                    android:textColor="#999999"
                    android:textSize="@dimen/text_size_11"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_manual_model_selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_manual_model_selection"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_13"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tv_manual_model_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_manual_model_selection_hint"
                    android:textColor="#999999"
                    android:textSize="@dimen/text_size_11"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_default_model_readonly_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/ai_default_model_readonly_hint"
                    android:textColor="#999999"
                    android:textSize="@dimen/text_size_11"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/model_usage_desc"
                    android:textColor="#999999"
                    android:textSize="@dimen/text_size_11" />

                <GridLayout
                    android:id="@+id/chip_group_prompt_modes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="3"
                    android:rowOrderPreserved="false"
                    android:useDefaultMargins="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btn_text_model"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:checkable="true"
                        android:text="@string/main_text_model"
                        android:textSize="@dimen/text_size_13"
                        app:checkedIconVisible="false"
                        app:chipMinHeight="36dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btn_vision_model"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:checkable="true"
                        android:text="@string/vision_model"
                        android:textSize="@dimen/text_size_13"
                        app:checkedIconVisible="false"
                        app:chipMinHeight="36dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btn_speech_prompt"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:checkable="true"
                        android:text="@string/voice_recognition"
                        android:textSize="@dimen/text_size_13"
                        app:checkedIconVisible="false"
                        app:chipMinHeight="36dp" />
                </GridLayout>

                <LinearLayout
                    android:id="@+id/layout_prompt_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/system_prompt"
                        android:textColor="#666666"
                        android:textSize="@dimen/text_size_12"/>

                    <TextView
                        android:id="@+id/tv_edit_prompt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/enable_edit"
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#F44336"
                        android:padding="4dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackground"/>

                    <TextView
                        android:id="@+id/tv_toggle_expand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/expand_content"
                        android:textSize="@dimen/text_size_12"
                        android:textColor="@color/brand_primary"
                        android:padding="4dp"
                        android:background="?attr/selectableItemBackground"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/layout_prompt_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">
                    <EditText
                        android:id="@+id/et_custom_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="@string/hint_single_mode_prompt"
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="@dimen/text_size_13"
                        android:textColor="#444444"/>
                    <EditText
                        android:id="@+id/et_multi_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="@string/hint_multi_mode_prompt"
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="@dimen/text_size_13"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                    <EditText
                        android:id="@+id/et_rule_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="@string/hint_rule_mode_prompt"
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="@dimen/text_size_13"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                    <EditText
                        android:id="@+id/et_receipt_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="@string/hint_receipt_mode_prompt"
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="@dimen/text_size_13"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                    <EditText
                        android:id="@+id/et_receipt_vision_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="@string/hint_visual_retry_prompt"
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="@dimen/text_size_13"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                    <EditText
                        android:id="@+id/et_receipt_ocr_refine_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="8"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:gravity="top"
                        android:hint="@string/hint_recognition_prompt"
                        android:background="@drawable/bg_search_box"
                        android:padding="12dp"
                        android:textSize="@dimen/text_size_13"
                        android:textColor="#444444"
                        android:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_mode_model"
                    android:textColor="#666666"
                    android:textSize="@dimen/text_size_12"
                    android:layout_marginBottom="6dp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_enable_thinking_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_thinking_current"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_13"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tv_thinking_scope_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/thinking_scope_hint"
                    android:textColor="#999999"
                    android:textSize="@dimen/text_size_11"
                    android:layout_marginBottom="10dp" />

                <!-- 模型选择器：点击弹出带搜索的选择弹窗 -->
                <LinearLayout
                    android:id="@+id/layout_model_selector"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner_rounded"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_selected_model"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:hint="@string/hint_select_model"
                        android:maxLines="1"
                        android:textColor="#333333"
                        android:textSize="@dimen/text_size_14" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/arrow_down_float"
                        android:alpha="0.5" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restore_default_models"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:text="@string/ai_restore_default_models"
                    android:textSize="@dimen/text_size_11"
                    android:textColor="#757575"
                    app:strokeColor="#DDDDDD"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:text="@string/reset_default_prompt"
                    android:textSize="@dimen/text_size_11"
                    android:textColor="#757575"
                    app:strokeColor="#DDDDDD"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_config"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/save_all_config"
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/brand_primary"
                android:layout_marginBottom="40dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
