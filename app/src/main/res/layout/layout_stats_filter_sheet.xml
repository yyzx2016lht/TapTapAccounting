<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_stats_scope_sheet"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="34dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_stats_sheet_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_filter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/filter_conditions"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/drag_handle" />

        <ImageView
            android:id="@+id/btn_close_filter_sheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="@id/tv_filter_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_filter_title"
            app:tint="@color/text_secondary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scroll_filter_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_stats_filter_section"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/quick_time"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <GridLayout
                    android:id="@+id/chipGroupQuickRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="5"
                    android:orientation="horizontal"
                    android:rowCount="2"
                    android:useDefaultMargins="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_today"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/today" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_yesterday"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/yesterday" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_day_before_yesterday"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/day_before_yesterday" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_this_week"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/this_week" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_last_week"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/last_week" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_this_month"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/this_month" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_last_month"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/last_month" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_this_year"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/this_year" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_last_year"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/last_year" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_filter_all"
                        style="@style/StatsFilterQuickButton" android:checkable="true"
                        android:text="@string/all" />
                </GridLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_stats_filter_section"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/custom_date"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tv_filter_start_date"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stats_filter_field_rect"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_home_calendar"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/tv_filter_start_date_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/start_date"
                            android:textColor="@color/text_tertiary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="—"
                        android:textColor="@color/text_tertiary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/tv_filter_end_date"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stats_filter_field_rect"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_home_calendar"
                            app:tint="@color/text_tertiary" />

                        <TextView
                            android:id="@+id/tv_filter_end_date_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/end_date"
                            android:textColor="@color/text_tertiary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_filter_currency_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stats_filter_section"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/currency_label"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/layout_filter_currency_selector"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_stats_filter_field_rect"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/tv_filter_currency_selector"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/all_currencies"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_filter_currency_expand"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_down_small"
                        app:tint="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_reset_filter_sheet"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_stats_filter_reset"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/reset"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_confirm_filter_sheet"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/dialog_button_height"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_stats_filter_confirm"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/apply_filter"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>



