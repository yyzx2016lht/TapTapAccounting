<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_currency_popup_panel"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/item_ms_merge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_ms_merge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_merge"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_15" />

        <TextView
            android:id="@+id/tv_ms_merge_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/payment_merge_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_12" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="12dp"
        android:background="@color/divider_soft" />

    <LinearLayout
        android:id="@+id/item_ms_exclude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:minHeight="56dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_ms_exclude_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exclude"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_15" />

        <TextView
            android:id="@+id/tv_ms_exclude_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/exclude_stats_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_12" />
    </LinearLayout>
</LinearLayout>
