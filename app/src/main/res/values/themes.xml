<resources>
    <style name="Theme.TapAccounting" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 主颜色配置 -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- 全局字体恢复系统默认无衬线 -->
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <!-- 次要颜色
             colorSecondary 是 Material 各选择控件（RadioButton / CheckBox /
             SwitchCompat / Chip 等）的选中态默认色。此前为 brand_secondary
             #FF4081（玫红），导致全项目 54 个未显式设置 tint 的选择控件
             呈玫红色（备份间隔、备份模式、恢复模块勾选、分类排序、
             账本收支切换、小组件周期等），与蓝的品牌主色割裂。
             现改为 brand_primary，选中态与主色统一。 -->
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Surface & background -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/danger_color</item>

        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Default corner radius for Material cards / sheets -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TapAccounting.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TapAccounting.MediumComponent</item>
    </style>

    <style name="ShapeAppearance.TapAccounting.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius_8</item>
    </style>

    <style name="ShapeAppearance.TapAccounting.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/radius_12</item>
    </style>

    <style name="Theme.TapAccounting.Transparent" parent="Theme.TapAccounting">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.TapAccounting.AppCompatNoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 选择控件选中态。与 Theme.TapAccounting 保持一致，
             否则这几个页面里的 RadioButton/CheckBox 会回落�� AppCompat 默认色。 -->
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
    </style>

    <style name="Animation_TapAccounting_DialogSoft">
        <item name="android:windowEnterAnimation">@anim/dialog_soft_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_soft_exit</item>
    </style>

    <style name="Animation_TapAccounting_BottomDialogSoft">
        <item name="android:windowEnterAnimation">@anim/dialog_bottom_soft_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_bottom_soft_exit</item>
    </style>

</resources>
